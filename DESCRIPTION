Package: prime
Type: Package
Title: Proportional Inclusive Marginal Effects
Version: 0.5.5
Authors@R: c(
    person("Youngseo", "Cho", role = c("aut", "cre", "cph"),
           email = "josun@gatech.edu"),
    person("V. Roshan", "Joseph", role = c("aut", "cph"))
